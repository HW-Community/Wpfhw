<Window x:Class="wpfhw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modrinth 下载器" 
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16 10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16 10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardAltBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#ff3b30"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <!-- Placeholder -->
                            <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource ThemeTertiaryText}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"
                                       Margin="12 0 0 0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeInputFocusBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 背景边框 -->
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <!-- ToggleButton 铺满整个区域，负责打开下拉 -->
                            <ToggleButton x:Name="toggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>

                            <!-- 选中项显示 -->
                            <ContentPresenter x:Name="content"
                                              Margin="12 0 30 0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <!-- 可编辑文本框 -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ThemePrimaryText}"
                                     BorderThickness="0"
                                     Margin="12 0 30 0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     Focusable="True"/>

                            <!-- 下拉箭头 -->
                            <Path x:Name="arrow"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{DynamicResource ThemeTertiaryText}"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0 0 12 0"
                                  IsHitTestVisible="False"/>

                            <!-- 下拉列表 Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   StaysOpen="False">
                                <Border Background="{DynamicResource ThemeWindowBackground}"
                                        BorderBrush="{DynamicResource ThemeCardAltBackground}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0 4 0 0">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                                  Margin="4">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 可编辑模式 -->
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 下拉打开时箭头旋转 -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeItemSelected}"/>
                                <Setter TargetName="border" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="12"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionTag" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardAltBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置页中的主题切换分段按钮 -->
        <Style x:Key="ThemeSegmentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="20 10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBackground}" CornerRadius="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Border x:Name="titleBar" Background="Transparent" Height="60" 
                    VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左上角小 Logo -->
                    <Grid Grid.Column="0" Width="40" Height="40" Margin="20 0 0 0"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image x:Name="imgSmallLogo"
                               Source="/logo.png"
                               Stretch="Uniform"
                               Width="32" Height="32">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="MD" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=imgSmallLogo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="1" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource ThemeCardBackground}" CornerRadius="25" Padding="4">
                        <Border Background="{DynamicResource ThemeWindowBackground}" CornerRadius="22" Opacity="0.95">
                            <StackPanel x:Name="navPanel" Orientation="Horizontal">
                                <Button x:Name="navMod" Content="模组" Tag="mod" 
                                        Click="Nav_Click" Style="{StaticResource SecondaryButton}"
                                        Background="Transparent" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold"/>
                                <Button x:Name="navResource" Content="资源包" Tag="resourcepack" 
                                        Click="Nav_Click" Style="{StaticResource SecondaryButton}"
                                        Background="Transparent"/>
                                <Button x:Name="navShader" Content="光影" Tag="shader" 
                                        Click="Nav_Click" Style="{StaticResource SecondaryButton}"
                                        Background="Transparent"/>
                                <Button x:Name="navData" Content="数据包" Tag="datapack" 
                                        Click="Nav_Click" Style="{StaticResource SecondaryButton}"
                                        Background="Transparent"/>
                                <Button x:Name="navPack" Content="整合包" Tag="modpack" 
                                        Click="Nav_Click" Style="{StaticResource SecondaryButton}"
                                        Background="Transparent"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0 0 20 0" 
                                VerticalAlignment="Center">
                        <Button x:Name="btnMinimize" Content="−" Width="32" Height="32" 
                                Click="BtnMinimize_Click" Style="{StaticResource SecondaryButton}"
                                FontSize="16" Padding="0"/>
                        <Button x:Name="btnClose" Content="×" Width="32" Height="32" 
                                Click="BtnClose_Click" Style="{StaticResource DangerButton}"
                                FontSize="16" Padding="0" Margin="8 0 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="20 70 20 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="panelSearch" Grid.Row="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" 
                            Padding="16" Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox x:Name="txtSearchKey" Width="300" 
                                     Style="{StaticResource ModernTextBox}"
                                     Tag="搜索模组(支持中文)..."
                                     Margin="0 0 10 0"
                                     KeyDown="TxtSearchKey_KeyDown"/>
                            
                            <ComboBox x:Name="cbbGameVersion" Width="130" 
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True" Margin="0 0 10 0">
                                <ComboBoxItem Content="全部版本"/>
                                <ComboBoxItem Content="1.20.1"/>
                                <ComboBoxItem Content="1.20.4"/>
                                <ComboBoxItem Content="1.21"/>
                                <ComboBoxItem Content="1.21.1"/>
                                <ComboBoxItem Content="26.1"/>
                                <ComboBoxItem Content="26.2"/>
                            </ComboBox>

                            <ComboBox x:Name="cbbLoader" Width="110" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0 0 10 0">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="fabric"/>
                                <ComboBoxItem Content="forge"/>
                                <ComboBoxItem Content="neoforge"/>
                                <ComboBoxItem Content="quilt"/>
                            </ComboBox>

                            <Button x:Name="btnSearch" Content="搜索" 
                                    Style="{StaticResource PrimaryButton}"
                                    Height="40" Click="BtnSearch_Click"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="lstModResult" Grid.Row="2" 
                             SelectionChanged="LstModResult_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModListItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="64" Height="64" 
                                            CornerRadius="16" Margin="0 0 16 0"
                                            Background="{DynamicResource ThemeCardBackground}" 
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding IconUrl}" 
                                               Stretch="UniformToFill"
                                               Width="64" Height="64">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconUrl}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>

                                    <Border Grid.Column="0" Width="64" Height="64" 
                                            CornerRadius="16" Margin="0 0 16 0"
                                            Background="{DynamicResource ThemeCardAltBackground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconUrl}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="?" FontSize="24" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource ThemeTertiaryText}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="16" 
                                                   FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryText}"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   Foreground="{DynamicResource ThemeSecondaryText}" FontSize="13"
                                                   TextWrapping="Wrap" MaxWidth="600"
                                                   Margin="0 4 0 0" LineHeight="20"/>
                                        <TextBlock Text="{Binding DownloadsDisplay}" 
                                                   Foreground="{DynamicResource ThemeTertiaryText}" FontSize="12"
                                                   Margin="0 4 0 0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 12 0 0">
                        <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="#34c759" Margin="0 0 8 0"
                                 Visibility="Collapsed"/>
                        <TextBlock x:Name="txtStatusMsg" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource ThemeTertiaryText}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 8 0 0" HorizontalAlignment="Center">
                        <Button x:Name="btnPrevPage" Content="上一页" 
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnPrevPage_Click" Margin="0 0 10 0"/>
                        <Button x:Name="btnNextPage" Content="下一页" 
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnNextPage_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="panelVersionDetail" Grid.Row="0" Grid.RowSpan="2" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="返回" 
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0 0 0 16"
                            Click="BtnBack_Click"/>

                    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBackground}" CornerRadius="20" 
                            Padding="24" Margin="0 0 0 16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="72" Height="72">
                                <Border Width="72" Height="72" 
                                        CornerRadius="18" ClipToBounds="True"
                                        Background="{DynamicResource ThemeCardAltBackground}">
                                    <Image Source="{Binding SelectedMod.IconUrl}" 
                                           Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMod.IconUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedMod.IconUrl}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                                <TextBlock Text="?" FontSize="28" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource ThemeTertiaryText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMod.IconUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedMod.IconUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16 0 0 0">
                                <TextBlock Text="{Binding SelectedMod.Title}" FontSize="22" 
                                           FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryText}"/>
                                <TextBlock Text="{Binding SelectedMod.Description}" 
                                           Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" 
                                           Margin="0 6 0 0" FontSize="13" LineHeight="22"/>
                                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                    <Button x:Name="btnOpenExternal" Content="访问 Modrinth" 
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0 0 8 0" Click="BtnOpenModrinth_Click"/>
                                    <Button Content="复制名称" 
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnCopyName_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0 0 0 12">
                        <TextBlock Text="选择游戏版本" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTertiaryText}" Margin="0 0 0 8"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly">
                            <StackPanel x:Name="panelVersionTags" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <ItemsControl x:Name="itemsVersionGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" 
                                            Margin="0 6 0 0" Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding VersionNumber}" 
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemePrimaryText}"/>
                                                <Border Background="#ff9500" CornerRadius="10" 
                                                        Padding="6 2" Margin="10 0 0 0"
                                                        Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="预览版" FontSize="10" 
                                                               Foreground="#ffffff"/>
                                                </Border>
                                                <Border Background="#34c759" CornerRadius="10" 
                                                        Padding="6 2" Margin="10 0 0 0"
                                                        Visibility="{Binding IsRelease, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="正式版" FontSize="10" 
                                                               Foreground="#ffffff"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding VersionInfo}" 
                                                       Foreground="{DynamicResource ThemeTertiaryText}" FontSize="12"
                                                       Margin="0 6 0 0"/>

                                            <Button Grid.Row="2" Content="下载" 
                                                    Style="{StaticResource PrimaryButton}"
                                                    Width="100" Height="36"
                                                    Margin="0 10 0 0" 
                                                    HorizontalAlignment="Left"
                                                    Tag="{Binding}" 
                                                    Click="BtnDownloadVersion_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="panelDownloadConfirm" Grid.Row="0" Grid.RowSpan="2" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="返回" 
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0 0 0 16"
                            Click="BtnBackFromDownload_Click"/>

                    <TextBlock Grid.Row="1" Text="确认下载" FontSize="24" 
                               FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryText}" Margin="0 0 16 0"/>

                    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" 
                            Padding="16" Margin="0 0 0 16">
                        <StackPanel>
                            <TextBlock Text="文件信息" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeTertiaryText}" Margin="0 0 0 8"/>
                            <TextBlock x:Name="txtDownloadFileName" FontSize="16" 
                                       Foreground="{DynamicResource ThemePrimaryText}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtDownloadVersionInfo" FontSize="13" 
                                       Foreground="{DynamicResource ThemeSecondaryText}" Margin="0 4 0 0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" 
                            Padding="16" Margin="0 0 0 16">
                        <StackPanel>
                            <TextBlock Text="保存位置" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeTertiaryText}" Margin="0 0 0 8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtDownloadPath" Width="500" 
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Margin="0 0 10 0"/>
                                <Button Content="浏览..." 
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnBrowseDownloadPath_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4" Content="开始下载" 
                            Style="{StaticResource PrimaryButton}"
                            Height="48" Width="200"
                            HorizontalAlignment="Left"
                            Click="BtnStartDownload_Click"/>
                </Grid>

                <Grid x:Name="panelDownloading" Grid.Row="0" Grid.RowSpan="2" 
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="正在下载" FontSize="24" 
                               FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryText}" Margin="0 0 16 0"/>

                    <TextBlock x:Name="txtDownloadingFile" Grid.Row="1" 
                               FontSize="16" Foreground="{DynamicResource ThemeSecondaryText}" Margin="0 0 12 0"/>

                    <Border Grid.Row="2" Background="{DynamicResource ThemeCardAltBackground}" CornerRadius="4" Height="8" 
                            Margin="0 0 0 8">
                        <Grid>
                            <Rectangle x:Name="progressBarFill" 
                                       Fill="{DynamicResource ThemeAccent}" 
                                       RadiusX="4" RadiusY="4"
                                       HorizontalAlignment="Left"
                                       Width="0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="txtDownloadPercent" Grid.Row="3" 
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource ThemeTertiaryText}" FontSize="12"/>
                </Grid>

                <!-- 设置面板 -->
                <Grid x:Name="panelSettings" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="返回" 
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0 0 0 16"
                            Click="BtnBackFromSettings_Click"/>

                    <TextBlock Grid.Row="1" Text="设置" FontSize="24" 
                               FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryText}" Margin="0 0 0 20"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 主题模式 -->
                            <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" Padding="20" Margin="0 0 0 16">
                                <StackPanel>
                                    <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemePrimaryText}" Margin="0 0 0 12"/>
                                    <TextBlock Text="选择应用的主题模式" FontSize="12"
                                               Foreground="{DynamicResource ThemeTertiaryText}" Margin="0 0 0 12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnThemeLight" Content="浅色" Tag="Light"
                                                Click="ThemeButton_Click" Style="{StaticResource ThemeSegmentButton}"/>
                                        <Button x:Name="btnThemeDark" Content="深色" Tag="Dark"
                                                Click="ThemeButton_Click" Style="{StaticResource ThemeSegmentButton}"/>
                                        <Button x:Name="btnThemeSystem" Content="跟随系统" Tag="System"
                                                Click="ThemeButton_Click" Style="{StaticResource ThemeSegmentButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 下载线程数 -->
                            <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="16" Padding="20" Margin="0 0 0 16">
                                <StackPanel>
                                    <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemePrimaryText}" Margin="0 0 0 12"/>
                                    <TextBlock Text="最大并发下载线程数" FontSize="12"
                                               Foreground="{DynamicResource ThemeTertiaryText}" Margin="0 0 0 12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnThreadMinus" Content="−" Width="36" Height="36"
                                                Style="{StaticResource SecondaryButton}" Padding="0" FontSize="18"
                                                Click="BtnThreadMinus_Click"/>
                                        <TextBlock x:Name="txtThreadCount" Text="3" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource ThemePrimaryText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Width="60"/>
                                        <Button x:Name="btnThreadPlus" Content="+" Width="36" Height="36"
                                                Style="{StaticResource SecondaryButton}" Padding="0" FontSize="18"
                                                Click="BtnThreadPlus_Click"/>
                                        <TextBlock Text="线程" FontSize="13"
                                                   Foreground="{DynamicResource ThemeSecondaryText}"
                                                   VerticalAlignment="Center" Margin="12 0 0 0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- GitHub 链接 -->
                            <Button x:Name="btnGithub" Click="BtnGithub_Click"
                                    HorizontalAlignment="Center" Margin="0 24 0 0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="访问 GitHub 仓库">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="22" Height="22" Stretch="Uniform"
                                          Fill="{DynamicResource ThemePrimaryText}"
                                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                                    <TextBlock Text="HW-Community / Wpfhw" FontSize="13"
                                               Foreground="{DynamicResource ThemeSecondaryText}"
                                               VerticalAlignment="Center" Margin="8 0 0 0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 右下角设置（齿轮）按钮 -->
            <Button x:Name="btnSettings" Click="BtnSettings_Click"
                    Width="44" Height="44"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    Background="{DynamicResource ThemeAccent}"
                    BorderThickness="0" Cursor="Hand"
                    ToolTip="设置">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Width="22" Height="22" Stretch="Uniform" Fill="#ffffff"
                      Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
            </Button>
        </Grid>
    </Border>
</Window>
