<Application x:Class="wpfhw.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 主题色板：浅色为默认值，运行时由 ThemeManager 切换为深色 -->
        <SolidColorBrush x:Key="ThemeWindowBackground" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeCardBackground" Color="#FFF2F2F7"/>
        <SolidColorBrush x:Key="ThemeCardAltBackground" Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="ThemeCardPressed" Color="#FFD1D1D6"/>
        <SolidColorBrush x:Key="ThemePrimaryText" Color="#FF333333"/>
        <SolidColorBrush x:Key="ThemeSecondaryText" Color="#FF666666"/>
        <SolidColorBrush x:Key="ThemeTertiaryText" Color="#FF999999"/>
        <SolidColorBrush x:Key="ThemeInputBackground" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputFocusBackground" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="ThemeItemHover" Color="#FFF2F2F7"/>
        <SolidColorBrush x:Key="ThemeItemSelected" Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="ThemeAccent" Color="#FF007AFF"/>
        <SolidColorBrush x:Key="ThemeAccentHover" Color="#FF3395FF"/>
        <SolidColorBrush x:Key="ThemeAccentPressed" Color="#FF0056B3"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Resources>
</Application>
