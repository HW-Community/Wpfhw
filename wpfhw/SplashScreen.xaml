<Window x:Class="wpfhw.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Splash"
        Height="320" Width="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="1">

    <Window.Resources>
        <Storyboard x:Key="SplashEnter">
            <DoubleAnimation Storyboard.TargetName="splashRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="splashScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.82" To="1" Duration="0:0:0.48">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="splashScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.82" To="1" Duration="0:0:0.48">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="logoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.7" To="1" Duration="0:0:0.55"
                             BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="logoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.7" To="1" Duration="0:0:0.55"
                             BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SplashExit">
            <DoubleAnimation Storyboard.TargetName="splashRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="splashScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.9" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="splashScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.9" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="splashRoot"
            Background="{DynamicResource ThemeWindowBackground}"
            CornerRadius="28"
            Width="200" Height="200"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="splashScale" ScaleX="0.82" ScaleY="0.82"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="36" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="28">
            <Grid>
                <Image x:Name="imgLogo"
                       Source="logo.png"
                       Stretch="Uniform"
                       Width="120" Height="120"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="logoScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>
    </Border>
</Window>
